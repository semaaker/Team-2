# ---------------------------------------------------------------------------
# SponsorMatch AI — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri kendinize göre düzenleyin.
# ---------------------------------------------------------------------------

# Express API'nin dinleyeceği port
PORT=4000

# Node ortamı: development | production | test
NODE_ENV=development

# Oturum token'larının imzalanmasında kullanılan gizli anahtar.
# Üretimde MUTLAKA uzun ve rastgele bir değerle değiştirin.
AUTH_SECRET=degistirin-bu-degeri-uzun-ve-rastgele-bir-anahtarla

# Token geçerlilik süresi (saniye) — varsayılan 7 gün
AUTH_TOKEN_TTL=604800

# CORS izin verilen origin listesi (virgülle ayrılmış)
CORS_ORIGIN=http://localhost:5173

# Mock API'ye eklenecek yapay gecikme (ms). Loading state'leri denemek için.
API_LATENCY_MS=180

# İstemcinin kullanacağı API taban adresi.
# Boş bırakılırsa göreli `/api` yolu kullanılır (Vite proxy devreye girer).
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Yapay zeka eşleştirme (n8n + Google Gemini)
# ---------------------------------------------------------------------------
# `workflows/03-sponsormatch-api.json` akışını n8n'e içe aktarıp etkinleştirin
# ve üretim webhook adresini buraya yazın. Örnek:
#   https://<n8n-alan-adiniz>/webhook/sponsormatch-ai/score
#
# BOŞ BIRAKILABİLİR. Boşken sunucu, yerleşik kural tabanlı skorlama motorunu
# kullanır; uygulama n8n olmadan da eksiksiz çalışır.
AI_WEBHOOK_URL=

# Webhook'u korumak için isteğe bağlı paylaşılan sır.
# Doluysa istekler `X-SponsorMatch-Token` başlığıyla gönderilir.
# Doğrulamanın etkin olması için aynı değeri n8n tarafında da `AI_WEBHOOK_TOKEN`
# ortam değişkeni olarak tanımlayın (bkz. workflows/README.md).
AI_WEBHOOK_TOKEN=

# n8n bu süre içinde yanıt vermezse yerel motora düşülür (ms).
AI_TIMEOUT_MS=8000
